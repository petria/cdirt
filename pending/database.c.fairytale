   STATE,OBJ_FAIRYTALE_STEAM_PIPE, PAR,2, PAR,OBJ_FAIRYTALE_STEAM_PIPE, PAR,1, PAR,0, PAR,0,
   SETSTATE, OK, NUL, NUL,

